{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kidinjurylaw",
  "compatibility_date": "2026-05-01",
  "observability": {
    "enabled": true
  },
  // `wrangler deploy` builds the site first (Astro -> dist/ + URL check), so a deploy works
  // even if the Cloudflare project's "Build command" field is left empty.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
