{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kidinjurylaw",
  "compatibility_date": "2026-05-01",
  "observability": {
    "enabled": true
  },
  // Static site built by Astro into dist/ (Cloudflare build command: npm run build).
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
