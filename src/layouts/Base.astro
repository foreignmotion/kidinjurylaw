---
import { SITE } from '../lib/site';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';

// Cache-busting: /assets/* is cached for a week, so asset URLs carry a hash of their contents.
const v = (file: string) => createHash('sha1').update(readFileSync(new URL(`../../public${file}`, import.meta.url))).digest('hex').slice(0, 10);
const cssHref = `/assets/css/site.css?v=${v('/assets/css/site.css')}`;
const jsSrc = `/assets/js/site.js?v=${v('/assets/js/site.js')}`;

interface Props {
  title: string;              // full <title>
  description?: string;
  path: string;               // canonical path, e.g. /2011/11/07/child-injury-dog-bite/
  ogType?: 'website' | 'article';
  ogImage?: string;           // absolute or root-relative
  jsonLd?: object[];
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}

const { title, description, path, ogType = 'website', ogImage, jsonLd = [], noindex = false, publishedTime, modifiedTime } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const image = new URL(ogImage ?? '/assets/img/og-image.jpg', SITE.url).href;
const fonts = 'https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap';

const msg = 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z';
const phone = 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
{description && <meta name="description" content={description}>}
<link rel="canonical" href={canonical}>
{noindex && <meta name="robots" content="noindex, follow">}
<meta name="theme-color" content="#395165">
<script is:inline>document.documentElement.classList.add('js')</script>

<meta property="og:type" content={ogType}>
<meta property="og:site_name" content={SITE.name}>
<meta property="og:title" content={title}>
{description && <meta property="og:description" content={description}>}
<meta property="og:url" content={canonical}>
<meta property="og:image" content={image}>
<meta property="og:locale" content="en_US">
{publishedTime && <meta property="article:published_time" content={publishedTime}>}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime}>}
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} feed`} href="/feed/">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href={fonts} media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href={fonts}></noscript>
<link rel="stylesheet" href={cssHref}>
{jsonLd.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(jsonLd.length === 1 ? jsonLd[0] : { '@context': 'https://schema.org', '@graph': jsonLd })} />}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__logo" href="/" aria-label="Kidinjury Law Blog by Pete Pearson — blog home">
      <img src="/assets/img/logo-ink.png" width="1532" height="267" alt="Pete Pearson — Atlanta Personal Injury Lawyer">
    </a>
    <nav class="site-nav" aria-label="Main">
      <a href={SITE.firmUrl}>Homepage</a>
      <a href={SITE.aboutUrl}>About the Attorney</a>
      <a href="/" aria-current="page">Kidinjury Law Blog</a>
    </nav>
    <div class="site-header__actions">
      <a class="btn btn--sm btn--primary" href={SITE.sms}><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d={msg}/></svg>Text Pete</a>
      <a class="btn btn--sm btn--outline" href={SITE.tel}><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d={phone}/></svg>Call Pete</a>
    </div>
    <div class="site-header__icons">
      <a class="icon-btn" href={SITE.sms} aria-label={`Text ${SITE.phoneDisplay}`}><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d={msg}/></svg></a>
      <a class="icon-btn" href={SITE.tel} aria-label={`Call ${SITE.phoneDisplay}`}><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d={phone}/></svg></a>
      <button class="icon-btn icon-btn--menu" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"><svg class="ic ic-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg><svg class="ic ic-close" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </div>
  </div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Main" hidden>
    <ul class="wrap">
      <li><a href={SITE.firmUrl}>Homepage</a></li>
      <li><a href={SITE.aboutUrl}>About the Attorney</a></li>
      <li><a href="/" aria-current="page">Kidinjury Law Blog</a></li>
    </ul>
  </nav>
</header>

<main id="main">
  <slot />

  <section class="band band--slate closing" aria-labelledby="closing-title">
    <div class="wrap">
      <h2 class="closing__title" id="closing-title">Get All Your Legal Questions Answered for Free - No Charge. No Commitments. No Stress.</h2>
      <p class="closing__para">Click the button below to send a text or voicemail. I will personally call you back as soon as possible.</p>
      <div class="closing__actions">
        <a class="btn btn--paper" href={SITE.sms}><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d={msg}/></svg><span>Text Attorney Pete<span aria-hidden="true"> &gt;&gt;</span></span></a>
        <a class="btn btn--outline-white" href={SITE.tel}><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d={phone}/></svg><span>Request my free consultation with Pete by phone<span aria-hidden="true"> &gt;&gt;</span></span></a>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__row">
      <img class="site-footer__logo" src="/assets/img/logo-white.png" width="1532" height="267" alt="Pete Pearson — Atlanta Personal Injury Lawyer" loading="lazy">
      <nav class="site-footer__nav" aria-label="Footer">
        <a href={SITE.firmUrl}>Homepage</a>
        <a href={SITE.aboutUrl}>About the Attorney</a>
        <a href="/">Kidinjury Law Blog</a>
      </nav>
      <div class="site-footer__social">
        <a href={SITE.avvo}>Avvo&nbsp;<span aria-hidden="true">↗</span></a>
        <a href={SITE.linkedin}>LinkedIn&nbsp;<span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="site-footer__fine">
      <p>"No fee until you win" refers only to fees charged by the attorney. Court costs and other additional expenses of legal action usually must be paid by the client.</p>
      <!-- TODO(client): add office address and privacy policy link (same as petepearsonlaw.com). -->
    </div>
  </div>
</footer>

<div class="action-bar" role="region" aria-label="Contact Pete">
  <a class="btn btn--primary" href={SITE.sms}><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d={msg}/></svg>Text Pete</a>
  <a class="btn btn--outline" href={SITE.tel}><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d={phone}/></svg>Call Pete</a>
</div>

<script is:inline src={jsSrc} defer></script>
</body>
</html>
