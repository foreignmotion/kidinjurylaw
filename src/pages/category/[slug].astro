---
import Archive from '../../components/Archive.astro';
import { getPosts, categories } from '../../lib/site';

// Every category URL from the old site (/category/<slug>/), including empty ones, so no old link 404s.
export async function getStaticPaths() {
  const posts = await getPosts();
  return categories.map((c) => ({
    params: { slug: c.slug },
    props: { name: c.name, description: c.description, posts: posts.filter((p) => p.data.categories.includes(c.slug)) },
  }));
}
const { name, description, posts } = Astro.props;
---
<Archive label="Topic" title={name} path={`/category/${Astro.params.slug}/`} posts={posts} description={description || undefined} noindex={posts.length === 0} />
